{
  "arch": "x86_64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "branch": "v3.23",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "localhost/openorb-guest-debian:x86_64",
    "runtime": "podman",
    "platform": "linux/amd64",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "gondolin-root",
    "sizeMb": 2560
  },
  "postBuild": {
    "copy": [
      {
        "src": "./openorb-image-release",
        "dest": "/etc/openorb-image-release"
      }
    ]
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
