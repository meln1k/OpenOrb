{
  "workspace": [
    "./packages/gateway",
    "./packages/protocol",
    "./packages/result",
    "./packages/runner"
  ],
  "exclude": [".openorb-runner-dev"],
  "unstable": ["no-legacy-abort"],
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./",
    "@earendil-works/gondolin": "npm:@earendil-works/gondolin@0.12.0",
    "@effect/platform-deno": "npm:@effect/platform-deno@4.0.0-rc.111",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/tar": "jsr:@std/tar@0.1.10",
    "effect": "npm:effect@4.0.0-rc.111",
    "remix/": "npm:/remix@3.0.0-beta.10/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "Deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true
  },
  "fmt": {
    "exclude": [
      ".amp/in",
      ".amp/portals",
      ".agents/skills",
      "packages/gateway/.agents",
      "packages/gateway/public",
      "packages/gateway/AGENTS.md",
      "packages/gateway/README.md",
      "packages/runner/test/fixtures/hostile-pi/global-agent/auth.json",
      "packages/runner/test/fixtures/hostile-pi/global-agent/models.json",
      "AGENTS.md",
      "deno_migration.md",
      "MASTER_PLAN.md",
      "MVP.md",
      "README.md",
      "tickets"
    ],
    "lineWidth": 100
  },
  "lint": {
    "exclude": [
      "scripts/anti-slop",
      "scripts/lint-rules",
      "scripts/lint-plugin.ts"
    ],
    "plugins": ["./scripts/lint-plugin.ts"]
  },
  "tasks": {
    "dev": {
      "dependencies": ["dev:gateway", "dev:runner"]
    },
    "dev:gateway": "deno task --filter @openorb/gateway dev",
    "dev:runner": "deno task --filter @openorb/runner dev",
    "check": "deno fmt --check && deno lint && deno check && deno task typecheck:effect",
    "check:docs": "deno task test scripts/documentation.test.ts",
    "test": "NODE_ENV=test deno test --allow-env --allow-ffi --allow-net=127.0.0.1,localhost --allow-read --allow-write --allow-sys=homedir",
    "test:security": "deno task test scripts/security-boundaries.test.ts packages/gateway/app/utils/secret-cipher.test.ts packages/gateway/test/auth.test.ts packages/gateway/test/credentials.test.ts packages/gateway/test/runner-registry.test.ts packages/gateway/test/session-provisioning-browser.test.ts packages/gateway/test/tenant-isolation.test.ts packages/runner/test/environment/gondolin/github-mediation.test.ts packages/runner/test/harness/pi/session.test.ts packages/runner/test/harness/pi/tools.test.ts",
    "test:gondolin": "GONDOLIN_START_TIMEOUT_MS=300000 OPENORB_RUN_GONDOLIN_TESTS=1 NODE_ENV=test deno test --allow-env --allow-ffi --allow-net --allow-read --allow-write --allow-sys=gid,homedir,networkInterfaces,uid --allow-run=qemu-system-aarch64,qemu-system-x86_64,qemu-img,ps,pwdx packages/runner/test/environment/gondolin/environment.test.ts packages/runner/test/environment/gondolin/github-mediation.integration.test.ts packages/runner/test/session/git-snapshot.test.ts",
    "release:acceptance": "deno run --frozen --allow-env --allow-net --allow-read --allow-run --allow-sys --allow-write scripts/release-acceptance.ts",
    "build:image": "PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin deno run --allow-read --allow-write --allow-net=dl-cdn.alpinelinux.org,github.com,raw.githubusercontent.com,release-assets.githubusercontent.com --allow-env --allow-run=which,mke2fs,mkfs.ext4,sh,du,podman,tar,debugfs --allow-sys=homedir,uid scripts/build-guest-image.ts",
    "compile:runner:linux-x64": "deno compile --frozen --target x86_64-unknown-linux-gnu --output dist/openorb-runner-linux-x64 --allow-read=.,/lib,/lib64,/usr/lib,/usr/lib64 --allow-write=. --allow-net --allow-env=PATH,PWD,NODE_V8_COVERAGE,TF_BUILD --allow-sys=cpus,gid,homedir,hostname,networkInterfaces,osRelease,statfs,systemMemoryInfo,uid --allow-run=/usr/bin/qemu-system-x86_64,/usr/bin/qemu-img packages/runner/src/standalone.ts",
    "compile:runner:linux-arm64": "deno compile --frozen --target aarch64-unknown-linux-gnu --output dist/openorb-runner-linux-arm64 --allow-read=.,/lib,/lib64,/usr/lib,/usr/lib64 --allow-write=. --allow-net --allow-env=PATH,PWD,NODE_V8_COVERAGE,TF_BUILD --allow-sys=cpus,gid,homedir,hostname,networkInterfaces,osRelease,statfs,systemMemoryInfo,uid --allow-run=/usr/bin/qemu-system-aarch64,/usr/bin/qemu-img packages/runner/src/standalone.ts",
    "release:runner": {
      "dependencies": [
        "compile:runner:linux-x64",
        "compile:runner:linux-arm64"
      ],
      "command": "deno run --allow-read=dist,packages/runner/systemd/openorb-runner.service --allow-write=dist scripts/runner-artifact-metadata.ts"
    }
  }
}
