{
  "workspace": [
    "./packages/control",
    "./packages/protocol",
    "./packages/runner"
  ],
  "unstable": ["no-legacy-abort"],
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./",
    "@earendil-works/gondolin": "npm:@earendil-works/gondolin@0.12.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/tar": "jsr:@std/tar@0.1.10"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "Deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "exclude": [
      ".amp/portals",
      ".agents/skills/deno",
      "packages/control/.agents",
      "packages/control/public",
      "packages/control/AGENTS.md",
      "packages/control/README.md",
      "packages/runner/test/fixtures/hostile-pi/global-agent/auth.json",
      "packages/runner/test/fixtures/hostile-pi/global-agent/models.json",
      "AGENTS.md",
      "deno_migration.md",
      "MASTER_PLAN.md",
      "MVP.md",
      "README.md",
      "tickets"
    ],
    "lineWidth": 100
  },
  "lint": {
    "exclude": [
      "scripts/anti-slop",
      "scripts/lint-plugin.ts"
    ],
    "plugins": ["./scripts/lint-plugin.ts"]
  },
  "tasks": {
    "dev": {
      "dependencies": ["dev:control", "dev:runner"]
    },
    "dev:control": "deno task --filter @openorb/control dev",
    "dev:runner": "deno task --filter @openorb/runner dev",
    "dev:otel": {
      "dependencies": ["dev:otel:control", "dev:otel:runner"]
    },
    "dev:otel:control": "deno task --filter @openorb/control dev:otel",
    "dev:otel:runner": "deno task --filter @openorb/runner dev:otel",
    "check": "deno fmt --check && deno lint && deno check",
    "test": "NODE_ENV=test deno test --allow-env --allow-ffi --allow-net=127.0.0.1,localhost --allow-read --allow-write --allow-sys=homedir",
    "test:gondolin": "OPENORB_RUN_GONDOLIN_TESTS=1 NODE_ENV=test deno test --allow-env --allow-ffi --allow-net --allow-read --allow-write --allow-sys=gid,homedir,networkInterfaces,uid --allow-run=qemu-system-aarch64,qemu-system-x86_64,qemu-img,ps,pwdx packages/runner/test/gondolin-tools.test.ts packages/runner/test/github-mediation.gondolin.test.ts packages/runner/test/session-provisioner.test.ts",
    "build:image": "PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin deno run --allow-read --allow-write --allow-net=dl-cdn.alpinelinux.org,github.com,raw.githubusercontent.com,release-assets.githubusercontent.com --allow-env --allow-run=which,mke2fs,mkfs.ext4,sh,du --allow-sys=homedir scripts/build-developer-image.ts",
    "compile:runner:linux-x64": "deno compile --frozen --target x86_64-unknown-linux-gnu --output dist/openorb-runner-linux-x64 --allow-read=. --allow-write=. --allow-net --allow-env=PATH,PWD --allow-sys=gid,homedir,networkInterfaces,statfs,systemMemoryInfo,uid --allow-run=qemu-system-x86_64,qemu-img packages/runner/src/index.ts",
    "compile:runner:linux-arm64": "deno compile --frozen --target aarch64-unknown-linux-gnu --output dist/openorb-runner-linux-arm64 --allow-read=. --allow-write=. --allow-net --allow-env=PATH,PWD --allow-sys=gid,homedir,networkInterfaces,statfs,systemMemoryInfo,uid --allow-run=qemu-system-aarch64,qemu-img packages/runner/src/index.ts",
    "release:runner": {
      "dependencies": [
        "compile:runner:linux-x64",
        "compile:runner:linux-arm64"
      ],
      "command": "deno run --allow-read=dist --allow-write=dist scripts/runner-artifact-metadata.ts"
    }
  }
}
