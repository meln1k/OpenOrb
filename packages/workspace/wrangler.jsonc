{
  "name": "openorb-workspace",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-07",
  "secrets": { "required": ["OPENORB_MASTER_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }]
}
