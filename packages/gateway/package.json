{
  "name": "@openorb/gateway",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./app/router.ts",
    "./server": "./server.ts"
  },
  "scripts": {
    "build:catalog": "node build-model-catalog.ts",
    "build:assets": "node build-assets.ts",
    "build": "npm run build:catalog && npm run build:assets && node build-worker.ts",
    "build:test": "npm run build && node build-worker.ts --test",
    "build:test:workspace": "node build-worker.ts --workspace-test",
    "prepare:dev": "node --env-file=.env prepare.ts",
    "generate-types": "npm run build && WRANGLER_SEND_METRICS=false wrangler types --include-runtime=false --strict-vars=false",
    "dev": "npm run prepare:dev && npm run build && celld dev wrangler.jsonc --host 127.0.0.1 --port 44100 --logs",
    "start": "celld dev wrangler.jsonc --host 127.0.0.1 --port 44100 --logs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@jsr/std__crypto": "1.1.0",
    "@jsr/std__encoding": "1.0.11",
    "@jsr/std__path": "1.1.6",
    "@jsr/std__streams": "1.1.2",
    "@jsr/std__uuid": "1.1.1",
    "@jsr/std__yaml": "1.3.0",
    "@openorb/pi-env": "*",
    "@openorb/protocol": "*",
    "@openorb/result": "*",
    "@opentelemetry/api": "1.9.0",
    "@pierre/diffs": "1.3.6",
    "@remix-run/ui": "0.12.1",
    "effect": "4.0.0",
    "just-bash": "3.6.0",
    "lucide": "1.31.0",
    "marked": "18.0.5",
    "modern-tar": "0.7.7",
    "quickjs-wasi": "3.6.2",
    "remix": "3.0.0"
  }
}
