{
  "name": "@openorb/gateway",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./app/router.ts",
    "./server": "./server.ts"
  },
  "imports": {
    "cloudflare:workers": "./test/workspace/runtime.ts",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "@/": "./",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@1.1.0",
    "@earendil-works/pi-ai/": "npm:/@earendil-works/pi-ai@1.1.0/",
    "@pierre/diffs": "npm:@pierre/diffs@^1.3.6",
    "@remix-run/ui/": "npm:/@remix-run/ui@0.12.1/",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/async": "jsr:@std/async@1.5.0",
    "@std/crypto/aes-gcm": "jsr:@std/crypto@1.1.0/aes-gcm",
    "@std/crypto/timing-safe-equal": "jsr:@std/crypto@1.1.0/timing-safe-equal",
    "@std/encoding/base64": "jsr:@std/encoding@1.0.11/base64",
    "@std/encoding/base64url": "jsr:@std/encoding@1.0.11/base64url",
    "@std/http/file-server": "jsr:@std/http@1.1.3/file-server",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/streams/limited-bytes-transform-stream": "jsr:@std/streams@1.1.2/limited-bytes-transform-stream",
    "@std/uuid": "jsr:@std/uuid@1.1.1",
    "lucide": "npm:lucide@1.31.0",
    "marked": "npm:marked@18.0.5",
    "remix/": "npm:/remix@3.0.0/"
  },
  "publish": false,
  "tasks": {
    "probe": "deno eval --frozen",
    "build:assets": "deno run --frozen --allow-read --allow-write=dist --allow-env --allow-ffi --allow-sys=uid build-assets.ts",
    "build:catalog": "deno run --frozen --allow-read --allow-write=dist --allow-env build-model-catalog.ts",
    "build:test": "deno task build && deno run --frozen --allow-read --allow-write=dist,test/dist --allow-run=deno build-worker.ts --test",
    "build:test:workspace": "deno bundle --frozen --platform=browser --external=cloudflare:workers test/workspace/celld-worker.ts -o test/workspace/dist/worker.js",
    "build": "deno task build:catalog && deno task build:assets && deno run --frozen --allow-read --allow-write=dist --allow-run=deno build-worker.ts",
    "generate-types": "deno task build && WRANGLER_SEND_METRICS=false deno run -A --frozen npm:wrangler@4.148.0 types --include-runtime=false --strict-vars=false",
    "prepare": "deno run --env-file=.env --allow-env=OPENORB_MASTER_KEY,SESSION_SECRET,PUBLIC_URL,OPENORB_SESSION_COOKIE_SECURE --allow-write=.dev.vars prepare.ts",
    "dev": "deno task prepare && deno task build && celld dev wrangler.jsonc --host 127.0.0.1 --port 44100 --logs",
    "start": "celld dev wrangler.jsonc --host 127.0.0.1 --port 44100 --logs"
  }
}
