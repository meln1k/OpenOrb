# Copy to packages/gateway/.env and adjust. The dev task prepares Worker
# bindings in packages/workspace/.dev.vars; start uses the prepared bindings.
# Variables already set in your shell take precedence during preparation.
SESSION_SECRET=replace-with-a-long-random-secret
# 256-bit application master key used to encrypt stored secrets (model API
# keys, Git tokens) in Workspace DO SQLite. Keep this key with existing state;
# never regenerate it for an upgrade. Accepts 64 hex characters or base64 encoding 32 bytes.
# Generate one with:  openssl rand -hex 32
OPENORB_MASTER_KEY=
# PUBLIC_URL=https://openorb.example.com
# OPENORB_SESSION_COOKIE_SECURE=true
