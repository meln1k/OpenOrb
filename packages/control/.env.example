# Copy to .env and adjust. The dev/start tasks load this file automatically
# via `--env-file=.env`. Variables already set in your shell take precedence.
DATABASE_URL=postgres://localhost/openorb
SESSION_SECRET=replace-with-a-long-random-secret
# 256-bit application master key used to encrypt stored secrets (model API
# keys, Git tokens). Required at startup; the control panel never generates
# or persists it. Accepts 64 hex characters or base64 encoding 32 bytes.
# Generate one with:  openssl rand -hex 32
OPENORB_MASTER_KEY=
# PORT=44100
