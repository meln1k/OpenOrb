{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "paths": {
      "cloudflare:workers": ["./packages/gateway/test/workspace/runtime.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "skipLibCheck": true,
    "types": ["node", "./packages/gateway/worker-configuration.d.ts"],
    "strict": true,
    "target": "ES2024",
    "verbatimModuleSyntax": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "**/dist", ".agents"]
}
