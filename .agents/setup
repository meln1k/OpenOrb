#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

as_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  else
    sudo -n -- "$@"
  fi
}

install_system_packages() {
  local qemu_package
  case "$(dpkg --print-architecture)" in
    amd64) qemu_package=qemu-system-x86 ;;
    arm64) qemu_package=qemu-system-arm ;;
    *)
      printf 'Unsupported Debian architecture: %s\n' "$(dpkg --print-architecture)" >&2
      return 1
      ;;
  esac

  local packages=(
    build-essential
    ca-certificates
    cpio
    curl
    e2fsprogs
    fuse-overlayfs
    lz4
    openssl
    podman
    qemu-utils
    uidmap
    unzip
    "$qemu_package"
  )
  local missing=()
  local package
  for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null |
      grep -Fqx 'installed'; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    echo 'System packages already installed.'
    return
  fi

  as_root env DEBIAN_FRONTEND=noninteractive apt-get update
  as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    "${missing[@]}"
}

install_deno() {
  local pinned_version
  pinned_version="$(awk '$1 == "deno" { print $2 }' .tool-versions)"
  if [[ -z "$pinned_version" ]]; then
    echo 'No Deno version is pinned in .tool-versions.' >&2
    return 1
  fi

  if command -v deno >/dev/null 2>&1 &&
    [[ "$(deno --version | awk 'NR == 1 { print $2 }')" == "$pinned_version" ]]; then
    echo "Deno $pinned_version already installed."
    return
  fi

  local target
  case "$(uname -m)" in
    x86_64) target=x86_64-unknown-linux-gnu ;;
    aarch64 | arm64) target=aarch64-unknown-linux-gnu ;;
    *)
      printf 'Unsupported CPU architecture: %s\n' "$(uname -m)" >&2
      return 1
      ;;
  esac

  local temp_dir
  temp_dir="$(mktemp -d)"
  curl --fail --location --silent --show-error \
    "https://github.com/denoland/deno/releases/download/v${pinned_version}/deno-${target}.zip" \
    --output "$temp_dir/deno.zip"
  unzip -q "$temp_dir/deno.zip" -d "$temp_dir"
  as_root install -m 0755 "$temp_dir/deno" /usr/local/bin/deno
  rm -rf -- "$temp_dir"

  deno --version | head -n 1
}

install_effect_solutions() {
  local version=0.5.3
  local expected="effect-solutions v$version"

  if command -v effect-solutions >/dev/null 2>&1 &&
    [[ "$(effect-solutions --version)" == "$expected" ]]; then
    echo "Effect Solutions $version already installed."
    return
  fi

  as_root deno install --global --allow-all --force --root /usr/local \
    --name effect-solutions "npm:effect-solutions@$version"

  if [[ "$(effect-solutions --version)" != "$expected" ]]; then
    echo "Effect Solutions $version installation failed." >&2
    return 1
  fi
}

clone_effect_repository() {
  local target="$HOME/.local/share/effect-solutions/effect"

  if [[ -d "$target/.git" ]]; then
    echo "Effect repository already cloned at $target."
    return
  fi
  if [[ -e "$target" ]]; then
    echo "$target exists but is not a Git repository." >&2
    return 1
  fi

  mkdir -p "$(dirname "$target")"
  git clone --depth 1 https://github.com/Effect-TS/effect-smol.git "$target"
}

clone_remix_repository() {
  local target="$HOME/.local/share/remix/remix"
  local ref='remix@3.0.0-rc.5'

  if [[ -d "$target/.git" ]]; then
    if ! git -C "$target" rev-parse --verify --quiet "refs/tags/$ref^{commit}" >/dev/null; then
      git -C "$target" fetch --depth 1 origin "refs/tags/$ref:refs/tags/$ref"
    fi

    if [[ "$(git -C "$target" rev-parse HEAD)" == \
      "$(git -C "$target" rev-parse "refs/tags/$ref^{commit}")" ]]; then
      echo "Remix repository already checked out at $ref."
      return
    fi

    git -C "$target" switch --detach "$ref"
    return
  fi
  if [[ -e "$target" ]]; then
    echo "$target exists but is not a Git repository." >&2
    return 1
  fi

  mkdir -p "$(dirname "$target")"
  git clone --depth 1 --branch "$ref" \
    https://github.com/remix-run/remix.git "$target"
}

create_local_environment() {
  local env_file=packages/gateway/.env
  if [[ -f "$env_file" ]]; then
    echo "$env_file already exists; leaving it unchanged."
    return
  fi

  umask 077
  local session_secret master_key
  session_secret="$(openssl rand -hex 32)"
  master_key="$(openssl rand -hex 32)"
  sed \
    -e "s|^SESSION_SECRET=.*|SESSION_SECRET=$session_secret|" \
    -e "s|^OPENORB_MASTER_KEY=.*|OPENORB_MASTER_KEY=$master_key|" \
    packages/gateway/.env.example >"$env_file"
  echo "Created ignored $env_file with orb-local secrets."
}

install_dependencies() {
  deno install --frozen
}

install_gotel() {
  local version=v0.0.0-20260906113606-1bc41cbc7240
  local go_version=1.27.1
  local toolchain="$HOME/.local/share/gotel/go-$go_version"
  if [[ ! -x "$toolchain/bin/go" ]]; then
    local architecture checksum
    case "$(uname -m)" in
      x86_64)
        architecture=amd64
        checksum=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
        ;;
      aarch64 | arm64)
        architecture=arm64
        checksum=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
        ;;
      *) echo 'GoTel requires Linux amd64 or arm64.' >&2; return 1 ;;
    esac
    local temp_dir
    temp_dir="$(mktemp -d)"
    curl --fail --location --silent --show-error \
      "https://go.dev/dl/go$go_version.linux-$architecture.tar.gz" \
      --output "$temp_dir/go.tar.gz"
    echo "$checksum  $temp_dir/go.tar.gz" | sha256sum --check
    tar -xzf "$temp_dir/go.tar.gz" -C "$temp_dir"
    mkdir -p "$(dirname "$toolchain")"
    mv "$temp_dir/go" "$toolchain"
    rm -rf -- "$temp_dir"
  fi

  if command -v gotel >/dev/null 2>&1 && command -v gotel-mcp >/dev/null 2>&1 &&
    "$toolchain/bin/go" version -m "$(command -v gotel)" | grep -Fq "$version"; then
    echo "GoTel $version already installed."
    return
  fi

  GOBIN="$HOME/.local/bin" CGO_ENABLED=1 GOMAXPROCS=2 \
    "$toolchain/bin/go" install "github.com/meln1k/gotel/cmd/...@$version"
  as_root ln -sfn "$HOME/.local/bin/gotel" /usr/local/bin/gotel
  as_root ln -sfn "$HOME/.local/bin/gotel-mcp" /usr/local/bin/gotel-mcp
  gotel help >/dev/null
}

step 'Install system packages' install_system_packages
step 'Install pinned Deno toolchain' install_deno
step 'Install pinned celld and esbuild' bash "$repo_root/scripts/install-celld.sh"
step 'Install Effect Solutions CLI' install_effect_solutions
step 'Clone Effect v4 reference repository' clone_effect_repository
step 'Clone Remix 3 RC 5 reference repository' clone_remix_repository
step 'Create local gateway environment' create_local_environment
step 'Install locked Deno dependencies' install_dependencies
step 'Install GoTel local observability tool' install_gotel

echo
echo 'Orb setup complete.'
