#!/usr/bin/env bash
set -euo pipefail

if ! command -v celld >/dev/null 2>&1 || ! command -v esbuild >/dev/null 2>&1; then
  echo 'celld or esbuild is not installed; run .agents/setup.' >&2
  exit 1
fi

# Supervised services are managed by .amp/services.yaml, not by this lifecycle hook.
# Never clean .celld state or rewrite existing secrets when an orb wakes.
echo 'Native Worker tools are available; use amp orb services ensure for services.'
